# Twilio WhatsApp Reminders
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
MY_WHATSAPP_NUMBER=whatsapp:+216XXXXXXXX

# Auth (required) — a long random string; changing it signs everyone out
JWT_SECRET=change-me-to-a-long-random-string

# Admin: this account becomes the super admin (on registration, or at the next migration)
OWNER_USERNAME=your_username
