{
  "name": "carb-cycle-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "build": "cd client && npm install --include=dev && npm run build",
    "start": "npm run migrate && npm run seed && node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.0"
  }
}
